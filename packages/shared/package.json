{
  "name": "@jhoond/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Types and validation schemas shared between the backend and dashboards",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@jhoond/tsconfig": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3"
  }
}
