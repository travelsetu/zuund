{
  "name": "@zuund/backend",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS API for zuund",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.4",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.4",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.0.4",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.7.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@zuund/shared": "workspace:*",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "maxmind": "^5.0.7",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.3",
    "@nestjs/testing": "^12.0.4",
    "@swc/core": "^1.16.2",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.2.1",
    "@zuund/tsconfig": "workspace:*",
    "dotenv": "^17.2.3",
    "prisma": "7.10.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.1"
  }
}
