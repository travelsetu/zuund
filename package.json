{
  "name": "jhoond",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:backend": "turbo run dev --filter=@jhoond/backend",
    "dev:dashboard": "turbo run dev --filter=@jhoond/admin-dashboard",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "pnpm --filter @jhoond/backend prisma:generate",
    "db:migrate": "pnpm --filter @jhoond/backend prisma:migrate",
    "db:seed": "pnpm --filter @jhoond/backend prisma:seed",
    "db:studio": "pnpm --filter @jhoond/backend prisma:studio",
    "bootstrap": "pnpm install && pnpm env:link && pnpm db:up && pnpm db:generate && pnpm db:migrate && pnpm db:seed",
    "dev:web": "turbo run dev --filter=@jhoond/web",
    "env:link": "node scripts/link-env.mjs",
    "deploy:trigger": "gh workflow run deploy.yml -R travelsetu/jhoond"
  },
  "devDependencies": {
    "prettier": "^3.9.8",
    "turbo": "^2.11.2",
    "typescript": "~5.9.3"
  }
}
