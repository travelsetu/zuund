# One .env for the whole monorepo. Copy it:   cp .env.example .env
# then run `node scripts/link-env.mjs` (pnpm bootstrap does this) so each app
# finds it beside itself. Never commit .env.

NODE_ENV=development

# ── Postgres (docker-compose.yml) ──────────────────────────────────────────
# Host port defaults to 5433 so it does not collide with a system Postgres on 5432.
POSTGRES_USER=zuund
POSTGRES_PASSWORD=zuund
POSTGRES_DB=zuund
POSTGRES_PORT=5433

# ── Backend (apps/backend) ─────────────────────────────────────────────────
# Must agree with the POSTGRES_* values above.
DATABASE_URL=postgresql://zuund:zuund@localhost:5433/zuund?schema=public
PORT=3000
HOST=0.0.0.0

# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_REFRESH_SECRET=change-me-to-a-different-random-string-of-32-chars
# Durations: <number><s|m|h|d>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# true wherever the API is served over HTTPS (production).
COOKIE_SECURE=false
# COOKIE_DOMAIN=zuund.com

# Comma-separated browser origins allowed to call the API with credentials.
# Production: https://admin.zuund.com,https://zuund.com
# Browsers allowed to call the API with cookies. Production: https://zuund.com,https://admin.zuund.com,https://app.zuund.com
# Local: admin (5173), marketing site (3001) and the Expo web app (8081).
CORS_ORIGIN=http://localhost:5173,http://localhost:3001,http://localhost:8081

# Public base URL of the API; file URLs are built from it. Production: https://api.zuund.com
PUBLIC_API_URL=http://localhost:3000
# Where uploads are written (served at PUBLIC_API_URL/uploads/…). Production: /srv/zuund-uploads
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=10485760

# ── Passes (business rules; see docs/PHASE1.md) ────────────────────────────
# Free Pass: ₹0, once per user for a car+city, this many days from "Join free".
FREE_PASS_DAYS=15
# Elite Pass: paise (₹499 = 49900), charged per buying post; days from the successful payment.
ELITE_PASS_AMOUNT=49900
ELITE_PASS_DAYS=30
# What happens to the pass when a member leaves a collective: NONE | FULL
REFUND_ON_LEAVE=NONE

# ── Location (IP → country/city suggestion) ────────────────────────────────
# DB-IP "IP to City Lite": free, no account, CC BY 4.0 (credited in the app and site footer).
# `node scripts/geoip-update.mjs` (and every deploy) downloads it to GEOIP_DB_PATH.
# Relative paths resolve from apps/backend. Production: /srv/zuund-geoip/dbip-city-lite.mmdb
GEOIP_DB_PATH=./data/dbip-city-lite.mmdb

# ── Payments ───────────────────────────────────────────────────────────────
# mock = dev only (refused in production). razorpay needs the three keys below.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set the same secret in the Razorpay dashboard webhook pointing at
# https://api.zuund.com/api/payments/webhook (events: payment.captured, payment.failed, refund.processed)
RAZORPAY_WEBHOOK_SECRET=

# Used by `pnpm db:seed` to create the first admin user (idempotent).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Admin

# ── Marketing site (apps/web, zuund.com) ───────────────────────────────────
# Where "Log in" / "Get started" send people. Local: the Expo web app on 8081.
# Production: https://app.zuund.com (the default when unset).
NEXT_PUBLIC_APP_URL=http://localhost:8081

# ── App (apps/mobile: iOS, Android and app.zuund.com) ──────────────────────
# Empty in development: the app derives http://<this Mac's LAN IP>:3000.
# `pnpm --filter @zuund/mobile build:web` defaults to https://api.zuund.com.
EXPO_PUBLIC_API_URL=

# ── Admin dashboard (apps/admin-dashboard) ─────────────────────────────────
# Where the Vite dev server forwards /api requests.
VITE_API_PROXY_TARGET=http://127.0.0.1:3000
# Base URL for API calls at runtime. Empty = same-origin /api (dev proxy).
# Production sets this to https://api.zuund.com.
VITE_API_BASE_URL=
